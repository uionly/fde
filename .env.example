# No environment file is required for credential-free local development.
# Copy this file to `.env` only when configuring optional services.

# Current supported mode. Shipped AI experiences are deterministic; no live
# provider adapter is implemented yet.
AI_MODE=mock

# Optional PostgreSQL learner-state database. Leave commented to use the
# process-memory development fallback.
# DATABASE_URL=postgresql://fde:fde@localhost:5432/fde_learning_lab

# Required in production. Generate with: openssl rand -base64 32
# AUTH_SECRET=replace-with-a-random-secret

# Optional Google sign-in. Configure both values or leave both blank.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Development credentials are already available when NODE_ENV is not
# production. Never enable them on a public deployment.
ENABLE_DEV_AUTH=false
