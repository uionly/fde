# No environment file is required for credential-free local development.
# Create `.env.local` only when overriding the documented default locally.

# Credential-free default. The capstone uses deterministic coaching in this mode.
AI_MODE=mock

# Optional live capstone coaching. Put real secrets only in `.env.local` or your
# hosting provider's server-side secret store; never add NEXT_PUBLIC_ to the key.
# AI_MODE=live
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-server-side-secret
# ANTHROPIC_MODEL=claude-sonnet-4-6
