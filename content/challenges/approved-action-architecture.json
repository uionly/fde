  "sources": [
    {
      "title": "OWASP Authorization Cheat Sheet",
      "url": "https://cheatsheetseries.owasp.org/cheatsheets/Authorization_Cheat_Sheet.html"
    }
  ],
  "hint": "Follow each directed path from entry to sensitive output. A disconnected guard cannot protect a bypass route.",
  "expertReasoning": "The model proposes a typed action. Approval covers the exact target and arguments; a trusted policy check revalidates authorization before an idempotent tool executes it. A queue may transport the approved work, but cannot introduce a path that skips approval or policy. These structural checks do not prove the policy implementation or replay resistance; test expiration, changed arguments, revoked roles, retries, and audit records in a real adapter.",
  "catalog": [
    {
      "id": "user",
      "label": "User",
      "responsibility": "Requests a consequential customer action."
    },
    {
      "id": "api",
      "label": "Application API",
      "responsibility": "Validates caller identity and accepts the request."
    },
    {
      "id": "identity",
      "label": "Identity provider",
      "responsibility": "Supplies caller identity to the application."
    },
    {
      "id": "model",
      "label": "Agent proposal",
      "responsibility": "Proposes typed arguments without executing the write."
    },
    {
      "id": "approval",
      "label": "Human approval",
      "responsibility": "Binds approval to exact target and arguments."
    },
    {
      "id": "policy",
      "label": "Policy check",
      "responsibility": "Rechecks authorization for the approved action immediately before execution."
    },
    {
      "id": "tool",
      "label": "Idempotent tool",
      "responsibility": "Executes approved writes using a stable operation key."
    },
    {
      "id": "queue",
      "label": "Approved work queue",
      "responsibility": "Optional durable transport for approved proposals."
    }
  ],
