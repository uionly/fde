{
  "id": "approved-action-architecture",
  "kind": "architecture",
  "title": "Design an approved ticket action",
  "description": "Build a proposal-to-execution path with explicit approval, authorization, and idempotent execution boundaries.",
  "skills": [
    "Architecture",
